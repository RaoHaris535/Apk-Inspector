# Public URL used by the browser to reach the analysis API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins accepted by the API.
APKINSPECTOR_ALLOWED_ORIGINS=http://localhost:3000

# Upload policy.
APKINSPECTOR_MAX_UPLOAD_MB=100
APKINSPECTOR_ANALYSIS_TIMEOUT_SECONDS=180
